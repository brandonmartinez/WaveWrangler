# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

# Installed reference templates use portable LF line endings.
.squad/templates/** text eol=lf

# Preserve the pinned upstream bytes while checking new first-party files normally.
Packages/WaveWranglerKit/Sources/WWWhisperNative/upstream/ggml-quants.h whitespace=-blank-at-eof
