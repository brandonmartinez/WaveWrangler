# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Local installer, derived memory, and live MCP configuration
.squad/.first-run
.squad/memory/index.json
.squad/memory/audit.jsonl
.mcp.json
.copilot/mcp-config.json

# Secrets and local macOS artifacts
.env
.env.*
!.env.example
!.env.sample
!.env.template
.DS_Store

# Build outputs (scripts/build.sh, scripts/test.sh, SwiftPM)
.build/
DerivedData/
*.xcresult
xcuserdata/
*.xcuserstate
.swiftpm/
Packages/WaveWranglerKit/.build/
