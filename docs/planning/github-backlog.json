  "milestones": [
    {
      "key": "M1",
      "title": "M1 — Durable organizer",
      "number": 1,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/1",
      "description": "Internal usable foundation: show/episode library and sidebar, versioned projects, recoverable cloud-location saves, autosave controls/explicit Save, immutable references, grouping/speakers/primaries/backups and relink. No audio decoding or analysis. Core safety/basic accessibility mandatory; broader release qualification is separate."
    },
    {
      "key": "M2",
      "title": "M2 — Recording alignment",
      "number": 2,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/2",
      "description": "Internal usable group-to-group alignment: validated import/time origins, offset/drift evidence, honest acoustic ambiguity/abstention, manual correction and channel-consistent aligned assets. No early uncut DAW handoff; first audio handoff remains cleaned-track M4."
    },
    {
      "key": "M3",
      "title": "M3 — Speech and edit review",
      "number": 3,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/3",
      "description": "Internal usable local primary-track transcription/contextual filler proposals, human accept/reject/boundaries, one safe common episode map, protected lift alternatives, reversible history and native preview/review. Offline/privacy/overlap protection/basic accessibility mandatory."
    },
    {
      "key": "M4",
      "title": "M4 — Cleaned-track MVP",
      "number": 4,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/4",
      "description": "First audio handoff and usable internal MVP: synchronized zero-origin cleaned speaker WAV stems plus editable reconstructive cut record/source recipe, demonstrated restoration and frozen-export status. No mandatory native adapter. Consented representative episode workflow; no external podcast publishing."
    },
    {
      "key": "M5",
      "title": "M5 — Accessible MVP qualification",
      "number": 7,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/7",
      "description": "Broad accessibility qualification across all MVP windows once the UI is stable after M4 (WW-053). Sits after M4 and before Release. Entry: M4 accepted; layouts and theme final; waiver baseline pinned at the M4 exit SHA. Essential accessibility stays a per-milestone invariant in M1-M4."
    },
    {
      "key": "Release",
      "title": "Release — Public distribution qualification",
      "number": 5,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/5",
      "description": "Separate public-release gate: signing/notarization/privacy/notices/chosen-build rights, clean install, actual macOS26/16GB and broader participant/accessibility/listening/resource/support validation. Core safety remains mandatory for internal use."
    },
    {
      "key": "Future",
      "title": "Future — Optional extensions",
      "number": 6,
      "url": "https://github.com/brandonmartinez/WaveWrangler/milestone/6",
      "description": "Nonblocking post-MVP portable media copies and explicitly chosen native DAW adapters. Neither is required for selected-primary neutral stems and editable cut-record MVP; full mixing/plugins/pause cleanup remain out of current scope."
    }
  ],
